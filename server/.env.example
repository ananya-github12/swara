# Sarvam AI key — used for speech-to-text, text-to-speech, and OCR via the Sarvam API
SARVAM_API_KEY=

# Google API key — used to call Gemini models for reasoning and form-field mapping
GOOGLE_API_KEY=

# Supabase project URL — the base URL of your Supabase project (e.g. https://xxxx.supabase.co)
SUPABASE_URL=
# Browser-safe Supabase key used only with a verified user JWT for RLS queries.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated exact origins, e.g. https://extension.example. Never use *.
SWARA_CORS_ALLOW_ORIGINS=

# Exact URL of the Alterity-owned Swara control-plane Edge Function. Leave empty
# to keep Swara in standalone development mode.
ALTERITY_CONTROL_PLANE_URL=

# Server-only credential for reserve/commit/release usage operations. Never put
# this value in the extension or in any VITE_/PUBLIC_ environment variable.
ALTERITY_SWARA_SERVICE_TOKEN=

# Stable product identifier used in entitlements and usage records.
SWARA_PRODUCT_KEY=swara
